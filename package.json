{
  "name": "plane-mobile-web-deployment",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "package:web": "python3 scripts/package_web.py",
    "test:package": "python3 -m unittest discover -s scripts -p test_package_web.py",
    "dev:web": "wrangler dev --local --ip 127.0.0.1",
    "check:deploy": "wrangler deploy --dry-run",
    "deploy:web": "wrangler deploy",
    "versions:web": "wrangler deployments list",
    "rollback:web": "wrangler rollback",
    "build:editor": "node scripts/build_editor.mjs",
    "check:editor": "node scripts/build_editor.mjs --check",
    "test:editor": "node --test test/web/work_item_editor_test.mjs"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "wrangler": "4.147.0"
  }
}
