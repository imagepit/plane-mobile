{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plane-mobile-pwa",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "https://plane.itpit.net/mobile/*", "zone_name": "itpit.net" }],
  "assets": {
    "directory": "build/pwa",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
